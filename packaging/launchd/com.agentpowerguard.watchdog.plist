<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agentpowerguard.watchdog</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/agent-power-guard</string>
        <string>daemon</string>
    </array>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/agent-power-guard.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/agent-power-guard.stderr.log</string>
</dict>
</plist>

