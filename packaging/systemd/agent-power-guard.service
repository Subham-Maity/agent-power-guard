[Unit]
Description=Agent Power Guard Watchdog Service
Documentation=https://github.com/Subham-Maity/agent-power-guard
After=network.target

[Service]
Type=simple
# For Debian/system installs (/usr/bin):
ExecStart=/usr/bin/agent-power-guard daemon
# If running standalone from ~/.local/bin, override with:
# ExecStart=%h/.local/bin/agent-power-guard daemon
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target

