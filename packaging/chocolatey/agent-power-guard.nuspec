<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>agent-power-guard</id>
    <version>1.3.0</version>
    <title>Agent Power Guard</title>
    <authors>Subham Maity</authors>
    <projectUrl>https://github.com/Subham-Maity/agent-power-guard</projectUrl>
    <licenseUrl>https://github.com/Subham-Maity/agent-power-guard/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Lightweight keep-awake watchdog utility for workstations running autonomous AI coding agents.</description>
    <summary>Puts your PC to sleep only when you AND your background AI agents are truly idle.</summary>
    <tags>power energy green watchdog sleep agent ai cursor claude</tags>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>

